// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// általános beállítások
datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  STUDENT
  COMPANY_ADMIN
  MENTOR
  UNIVERSITY_USER
  SYSTEM_ADMIN
}

enum ApplicationStatus {
  SUBMITTED
  ACCEPTED
  PENDING
  REJECTED
  NO_RESPONSE
  RETRACTED
}

enum LogStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PartnershipStatus {
  PENDING_MENTOR
  PENDING_UNIVERSITY
  ACTIVE
  FINISHED
  TERMINATED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PositionType {
  DUAL
  PROFESSIONAL_PRACTICE
  REGULAR_WORK
}

// ---------------------------------------------------------
// FELHASZNÁLÓK ÉS PROFILOK
// ---------------------------------------------------------

model User {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  fullName    String
  phoneNumber String
  role        Role

  isEmailEnabled Boolean @default(true)

  isEmailVerified         Boolean   @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime? @db.Timestamptz(3)

  isActive Boolean @default(true)

  passwordResetToken String?
  tokenExpiry        DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  // Kapcsolatok
  studentProfile  StudentProfile?
  companyEmployee CompanyEmployee?

  uniPartnerships DualPartnership[]

  // Referensi kapcsolatok (University User esetén)
  managedMajors    Major[]   @relation("MajorToUniversityUser")
  managedCompanies Company[] @relation("CompanyToUniversityUser")

  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([verificationToken])
  @@index([passwordResetToken])
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  mothersName String
  birthDate   DateTime @db.Timestamptz(3)

  // Egy felhasználónak több helyszíne is lehet (pl. otthoni, munkahelyi)
  locations          Location[]
  highSchool         String
  highSchoolLocation String
  graduationYear     Int
  neptunCode         String?
  majorId            String?
  major              Major?     @relation("CurrentMajor", fields: [majorId], references: [id])
  studyMode          String
  hasLanguageCert    Boolean    @default(false)

  isInHighSchool Boolean @default(false)
  firstChoiceId  String?
  firstChoice    Major?  @relation("FirstChoice", fields: [firstChoiceId], references: [id])
  secondChoiceId String?
  secondChoice   Major?  @relation("SecondChoice", fields: [secondChoiceId], references: [id])

  motivationLetter String?

  language      String?
  languageLevel String?

  isAvailableForWork Boolean @default(false)

  deletedAt DateTime? @db.Timestamptz(3)

  applications        Application[]
  partnerships        DualPartnership[]
  materialCompletions MaterialCompletion[]

  @@index([majorId])
  @@index([firstChoiceId])
  @@index([secondChoiceId])
}

model CompanyEmployee {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  jobTitle  String?
  deletedAt DateTime? @db.Timestamptz(3)

  mentoredPartnerships DualPartnership[]

  @@index([companyId])
}

model Location {
  id      String @id @default(uuid())
  country String @default("Magyarország")
  zipCode String
  city    String
  address String

  // OPCIONÁLIS KAPCSOLATOK

  // Ha céghez tartozik
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Ha kifejezetten a hallgatói profilhoz akarod kötni
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])

  // A pozíciók továbbra is mutathatnak egy konkrét helyszínre
  positions Position[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([companyId])
  @@index([studentProfileId])
}

model Major {
  id       String @id @default(uuid())
  name     String
  language String

  // Kapcsolatok - hallgatók akik ezt a szakot választották
  studentsWithMajor        StudentProfile[] @relation("CurrentMajor")
  studentsWithFirstChoice  StudentProfile[] @relation("FirstChoice")
  studentsWithSecondChoice StudentProfile[] @relation("SecondChoice")

  // Kapcsolatok - pozíciók amelyek ehhez a szakhoz tartoznak
  positions Position[]

  // Kari referensek, akik ehhez a szakhoz tartoznak
  managedBy User[] @relation("MajorToUniversityUser")
}

// ---------------------------------------------------------
// CÉGEK ÉS POZÍCIÓK
// ---------------------------------------------------------

model Company {
  id String @id @default(uuid())

  name  String
  taxId String @unique

  description String?

  contactName  String
  contactEmail String
  website      String?
  logoUrl      String?

  hasOwnApplication      Boolean @default(false)
  externalApplicationUrl String? // Külső jelentkezési URL (pl. Mercedes)

  status    RegistrationStatus @default(PENDING)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime?          @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?          @db.Timestamptz(3)

  employees CompanyEmployee[]
  positions Position[]

  location Location[]
  images   CompanyImage[]

  // Kari referensek, akik ehhez a céghez tartoznak
  managedBy User[] @relation("CompanyToUniversityUser")
}

model Position {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  title       String
  description String?

  majorId String?
  major   Major?  @relation(fields: [majorId], references: [id])

  type PositionType @default(DUAL)

  tags Tag[]

  deadline DateTime? @db.Timestamptz(3)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  applications     Application[]
  location         Location?         @relation(fields: [locationId], references: [id])
  locationId       String?
  dualPartnerships DualPartnership[]

  @@index([companyId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([majorId])
  @@index([locationId])
  @@index([deadline])
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String    @default("Technology")
  deletedAt DateTime? @db.Timestamptz(3)

  positions Position[]
}

// ---------------------------------------------------------
// JELENTKEZÉS ÉS KÉPZÉS FOLYAMATA
// ---------------------------------------------------------

model Application {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  status ApplicationStatus @default(SUBMITTED)

  companyNote String?

  submittedAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  @@unique([studentId, positionId])
  @@index([studentId])
  @@index([positionId])
  @@index([status])
  @@index([submittedAt])
  @@index([deletedAt])
}

model DualPartnership {
  id String @id @default(uuid())

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])

  mentorId String?
  mentor   CompanyEmployee? @relation(fields: [mentorId], references: [id])

  uniEmployeeId String?
  uniEmployee   User?   @relation(fields: [uniEmployeeId], references: [id])

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  semester       String
  contractNumber String?

  status    PartnershipStatus @default(ACTIVE)
  startDate DateTime          @db.Timestamptz(3)
  endDate   DateTime?         @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([studentId])
  @@index([mentorId])
  @@index([uniEmployeeId])
  @@index([positionId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

// ---------------------------------------------------------
// RENDSZER ÉS BIZTONSÁG
// ---------------------------------------------------------

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String
  type    String

  isRead Boolean @default(false)

  status String    @default("PENDING") // PENDING, SENT, FAILED
  error  String? // Hibaüzenet tárolása, ha nem sikerült
  sentAt DateTime? @db.Timestamptz(3)

  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, isArchived])
  @@index([createdAt])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId String?
  details  Json?

  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([entity])
  @@index([timestamp])
}

model News {
  id String @id @default(uuid())

  title   String
  content String

  isImportant Boolean @default(false)
  targetGroup String  @default("All")

  tags String[]

  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  @@index([isArchived])
  @@index([deletedAt])
  @@index([createdAt])
}

// ---------------------------------------------------------
// TANANYAGOK (LEARNING MATERIALS)
// ---------------------------------------------------------

model MaterialCompletion {
  id String @id @default(uuid())

  materialId String

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])

  isCompleted Boolean @default(true)
  rating      Int? // Opcionális értékelés (pl. 1-5, vagy 1-10)

  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([studentProfileId, materialId]) // Egy diák egy adott tananyagot csak egyszer végezhet el
  @@index([studentProfileId])
  @@index([completedAt])
}

// ---------------------------------------------------------
// GALÉRIÁK ÉS KÉPEK
// ---------------------------------------------------------

model GalleryGroup {
  id          String  @id @default(uuid())
  title       String
  description String?

  images GalleryImage[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model GalleryImage {
  id             String       @id @default(uuid())
  galleryGroupId String
  galleryGroup   GalleryGroup @relation(fields: [galleryGroupId], references: [id], onDelete: Cascade)

  url      String // Fájl relatív elérhetősége / uploads/...
  publicId String? // felhő alapú tárolás esetén a public ID
  caption  String?
  order    Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([galleryGroupId])
}

model CompanyImage {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  url      String
  publicId String?
  caption  String?
  order    Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([companyId])
}
